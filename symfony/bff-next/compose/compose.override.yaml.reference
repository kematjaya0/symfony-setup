services:
  postgres:
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"

  backend:
    build:
      target: development
    environment:
      APP_ENV: dev
      APP_DEBUG: "1"
      SERVER_NAME: :8080
    volumes:
      - ./backend:/app
      - backend_vendor:/app/vendor
      - ./backend/config/jwt:/run/jwt:ro
    ports:
      - "127.0.0.1:${BACKEND_PORT:-8080}:8080"

  frontend:
    build:
      target: development
    environment:
      NODE_ENV: development
      WATCHPACK_POLLING: "true"
    volumes:
      - ./frontend:/app
      - frontend_node_modules:/app/node_modules
      - frontend_next:/app/.next
    command: ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]

  migrate:
    build:
      target: development
    environment:
      APP_ENV: dev
      APP_DEBUG: "1"
    volumes:
      - ./backend:/app
      - backend_vendor:/app/vendor
      - ./backend/config/jwt:/run/jwt:ro

  schema-update:
    build:
      target: development
    environment:
      APP_ENV: dev
      APP_DEBUG: "1"
    volumes:
      - ./backend:/app
      - backend_vendor:/app/vendor
      - ./backend/config/jwt:/run/jwt:ro

  console:
    build:
      target: development
    environment:
      APP_ENV: dev
      APP_DEBUG: "1"
    volumes:
      - ./backend:/app
      - backend_vendor:/app/vendor
      - ./backend/config/jwt:/run/jwt:ro

  adminer:
    image: adminer:5-standalone
    profiles: [dev]
    restart: unless-stopped
    environment:
      ADMINER_DEFAULT_SERVER: postgres
    ports:
      - "127.0.0.1:${ADMINER_PORT:-8081}:8080"
    depends_on:
      postgres:
        condition: service_healthy
    networks: [internal]
    security_opt: [no-new-privileges:true]

  composer:
    volumes:
      - backend_vendor:/app/vendor

volumes:
  backend_vendor:
  frontend_node_modules:
  frontend_next:
